{
  "name": "telegram-auto-poll",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Automatically turn OpenClaw Telegram choices and confirmations into native polls",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "openclaw.plugin.json",
    "plugins/telegram-auto-poll"
  ],
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "scripts": {
    "test": "npm --prefix plugins/telegram-auto-poll test",
    "check:host": "node plugins/telegram-auto-poll/scripts/check-host.mjs --legacy-root"
  },
  "engines": {
    "node": ">=20"
  }
}
